# Charles H. Leggett's .slate file.

config defaultToCurrentScreen true
config nudgePercentOf screenSize
config resizePercentOf screenSize

# Move Bindings
# Maximize
bind m:ctrl;cmd            move screenOriginX;screenOriginY screenSizeX;screenSizeY

# Nudge Bindings
## Using arrow keys
bind up:ctrl;alt;cmd       nudge +0   -5%
bind down:ctrl;alt;cmd     nudge +0   +5%
bind left:ctrl;alt;cmd     nudge -5% +0
bind right:ctrl;alt;cmd    nudge +5% +0
## Using Vi keybingings
bind k:ctrl;alt;cmd        nudge +0   -5%
bind j:ctrl;alt;cmd        nudge +0   +5%
bind h:ctrl;alt;cmd        nudge -5% +0
bind l:ctrl;alt;cmd        nudge +5% +0

# Resize Bindings
## Using arrow keys
bind up:ctrl;alt           resize +0   -5%
bind down:ctrl;alt         resize +0   +5%
bind left:ctrl;alt         resize -5% +0
bind right:ctrl;alt        resize +5% +0
## Using Vi keybingings
bind k:ctrl;alt            resize +0   -5%
bind j:ctrl;alt            resize +0   +5%
bind h:ctrl;alt            resize -5% +0
bind l:ctrl;alt            resize +5% +0

# Push Bindings
## Using arrow keys
bind up:ctrl;cmd           push up    bar-resize:screenSizeY/2
bind down:ctrl;cmd         push down  bar-resize:screenSizeY/2
bind left:ctrl;cmd         push left  bar-resize:screenSizeX/2
bind right:ctrl;cmd        push right bar-resize:screenSizeX/2
## Using Vi keybingings
bind k:ctrl;cmd            push up    bar-resize:screenSizeY/2
bind j:ctrl;cmd            push down  bar-resize:screenSizeY/2
bind h:ctrl;cmd            push left  bar-resize:screenSizeX/2
bind l:ctrl;cmd            push right bar-resize:screenSizeX/2

# Throw Bindings
#bind 1:ctrl;alt         throw 0 resize
#bind 2:ctrl;alt         throw 1 resize
#bind 3:ctrl;alt         throw 2 resize
#bind right:ctrl;alt;cmd throw right resize
#bind left:ctrl;alt;cmd  throw left  resize
#bind up:ctrl;alt;cmd    throw up    resize
#bind down:ctrl;alt;cmd  throw down  resize

# Focus Bindings
# bind right:cmd    focus right
# bind left:cmd     focus left
# bind up:cmd       focus up
# bind down:cmd     focus down
# bind up:cmd;alt   focus behind
# bind down:cmd;alt focus behind

# Window Hints
# bind esc:cmd hint
