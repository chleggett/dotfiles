# Charles H. Leggett's .slate file.
# It is based on the default .slate file. Conflicts are commented.

config defaultToCurrentScreen true
config nudgePercentOf screenSize
config resizePercentOf screenSize

# CHL 2013.04.06 - In the Resize Bindings section, the first two conflict with
# single word move in OSX so, I am using only the ctrl;alt modifiers but,
# dropping the bottom-right.

# Resize Bindings
# bind right:alt       resize +10% +0
# bind left:alt        resize -10% +0
# bind up:alt          resize +0   -10%
# bind down:alt        resize +0   +10%
bind right:ctrl;alt  resize +10% +0
bind left:ctrl;alt   resize -10% +0
bind down:ctrl;alt   resize +0   +10%
bind up:ctrl;alt     resize +0   -10%

# Push Bindings
bind right:ctrl;cmd  push right bar-resize:screenSizeX/2
bind left:ctrl;cmd   push left  bar-resize:screenSizeX/2
bind up:ctrl;cmd     push up    bar-resize:screenSizeY/2
bind down:ctrl;cmd   push down  bar-resize:screenSizeY/2

# Nudge Bindings
bind right:ctrl;alt;cmd       nudge +10% +0
bind left:ctrl;alt;cmd        nudge -10% +0
bind up:ctrl;alt;cmd          nudge +0   -10%
bind down:ctrl;alt;cmd        nudge +0   +10%

# Throw Bindings
bind 1:ctrl;alt         throw 0 resize
bind 2:ctrl;alt         throw 1 resize
bind 3:ctrl;alt         throw 2 resize
bind right:ctrl;alt;cmd throw right resize
bind left:ctrl;alt;cmd  throw left  resize
bind up:ctrl;alt;cmd    throw up    resize
bind down:ctrl;alt;cmd  throw down  resize

# CHL 2013.04.10 - In the Focus Bindings section, many of these conflict
# with existing shortcuts.

# Focus Bindings
# bind right:cmd    focus right
# bind left:cmd     focus left
# bind up:cmd       focus up
# bind down:cmd     focus down
# bind up:cmd;alt   focus behind
# bind down:cmd;alt focus behind

# Window Hints
bind esc:cmd hint
