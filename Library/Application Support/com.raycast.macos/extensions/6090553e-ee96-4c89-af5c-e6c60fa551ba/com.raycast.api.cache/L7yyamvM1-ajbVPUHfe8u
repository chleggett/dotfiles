dia.org/wiki/Stoicism","bookmarked":false},{"title":"86.10 - GORA","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/86 - GGC GRC/86.10 - GORA/86.10 - GORA.md","lastModified":"2022-07-22T16:24:12.000Z","tags":[],"content":"# 86.10 - GORA","bookmarked":false},{"title":"86.08 - CJIS","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/86 - GGC GRC/86.08 - CJIS/86.08 - CJIS.md","lastModified":"2022-07-22T16:23:49.000Z","tags":[],"content":"# 86.08 - CJIS","bookmarked":false},{"title":"86.07 - GDPR","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/86 - GGC GRC/86.07 - GDPR/86.07 - GDPR.md","lastModified":"2022-07-22T16:23:35.000Z","tags":[],"content":"# 86.07 - GDPR","bookmarked":false},{"title":"86.05 - HIPAA","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/86 - GGC GRC/86.05 - HIPAA/86.05 - HIPAA.md","lastModified":"2022-07-22T16:22:53.000Z","tags":[],"content":"# 86.05 - HIPAA","bookmarked":false},{"title":"86.03 - FERPA","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/86 - GGC GRC/86.03 - FERPA/86.03 - FERPA.md","lastModified":"2022-07-22T16:22:00.000Z","tags":[],"content":"# 86.03 - FERPA","bookmarked":false},{"title":"GGC ITEC Lab IP Ranges","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/85 - GGC Technology/85.02 - Network/GGC ITEC Lab IP Ranges.md","lastModified":"2022-06-13T15:38:28.000Z","tags":[],"content":"# GGC ITEC Lab IP Ranges\n172.20.0.0-172.20.1.255","bookmarked":false},{"title":"GGC Server IP Ranges","path":"/Users/cleggett1/Obsidian/TheCollective/Lists/_OLD/80 - GGC/85 - GGC Technology/85.02 - Network/GGC Server IP Ranges.md","lastModified":"2022-06-13T15:37:41.000Z","tags":[],"content":"# GGC Server IP Ranges\n10.0.66.0-10.0.66.255\n10.42.0.0-10.42.2.255\n10.42.100.0-10.42.103.255\n10.42.206.0-10.42.206.255\n10.42.220.0-10.42.233.255\n10.254.0.0-10.254.3.255\n172.22.4.0-172.22.7.255","bookmarked":false},{"title":"Vanity Call Signs","path"