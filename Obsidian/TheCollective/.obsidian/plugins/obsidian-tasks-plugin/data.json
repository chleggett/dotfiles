{
  "globalQuery": "short mode\nhide created date",
  "globalFilter": "",
  "removeGlobalFilter": false,
  "taskFormat": "dataview",
  "setCreatedDate": true,
  "setDoneDate": true,
  "setCancelledDate": true,
  "autoSuggestInEditor": true,
  "autoSuggestMinMatch": 0,
  "autoSuggestMaxItems": 6,
  "provideAccessKeys": true,
  "useFilenameAsScheduledDate": false,
  "filenameAsDateFolders": [],
  "recurrenceOnNextLine": false,
  "statusSettings": {
    "coreStatuses": [
      {
        "symbol": " ",
        "name": "NotStarted",
        "nextStatusSymbol": "x",
        "availableAsCommand": true,
        "type": "TODO"
      },
      {
        "symbol": "x",
        "name": "Done",
        "nextStatusSymbol": "*",
        "availableAsCommand": true,
        "type": "DONE"
      }
    ],
    "customStatuses": [
      {
        "symbol": "/",
        "name": "InProgress",
        "nextStatusSymbol": "?",
        "availableAsCommand": true,
        "type": "IN_PROGRESS"
      },
      {
        "symbol": "-",
        "name": "Cancelled",
        "nextStatusSymbol": " ",
        "availableAsCommand": true,
        "type": "CANCELLED"
      },
      {
        "symbol": ">",
        "name": "Delegated",
        "nextStatusSymbol": "<",
        "availableAsCommand": false,
        "type": "IN_PROGRESS"
      },
      {
        "symbol": "<",
        "name": "Scheduled",
        "nextStatusSymbol": "!",
        "availableAsCommand": false,
        "type": "TODO"
      },
      {
        "symbol": "?",
        "name": "WaitingFor",
        "nextStatusSymbol": "\"",
        "availableAsCommand": false,
        "type": "IN_PROGRESS"
      },
      {
        "symbol": "!",
        "name": "OnHold",
        "nextStatusSymbol": "-",
        "availableAsCommand": false,
        "type": "TODO"
      },
      {
        "symbol": "*",
        "name": "Today",
        "nextStatusSymbol": "/",
        "availableAsCommand": false,
        "type": "IN_PROGRESS"
      },
      {
        "symbol": "\"",
        "name": "AgendaItem",
        "nextStatusSymbol": ">",
        "availableAsCommand": false,
        "type": "TODO"
      }
    ]
  },
  "features": {
    "INTERNAL_TESTING_ENABLED_BY_DEFAULT": true
  },
  "generalSettings": {},
  "headingOpened": {
    "Core Statuses": true,
    "Custom Statuses": true
  },
  "debugSettings": {
    "ignoreSortInstructions": false,
    "showTaskHiddenData": false,
    "recordTimings": false
  },
  "loggingOptions": {
    "minLevels": {
      "": "info",
      "tasks": "info",
      "tasks.Cache": "info",
      "tasks.Events": "info",
      "tasks.File": "info",
      "tasks.Query": "info",
      "tasks.Task": "info"
    }
  }
}