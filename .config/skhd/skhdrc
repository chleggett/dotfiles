# Charles H. Leggett's skhdrc
# There are many like it, but this one is mine.

# Navigate Desktops
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5
ctrl - 6 : yabai -m space --focus 6
ctrl - 7 : yabai -m space --focus 7
ctrl - 8 : yabai -m space --focus 8
ctrl - 9 : yabai -m space --focus 9
ctrl - 0 : yabai -m space --focus 0

# Zoom window
ctrl - space : yabai -m window --toggle zoom-fullscreen

# Move window
ctrl - u : yabai -m window --space prev ; yabai -m space --focus prev
ctrl - i : yabai -m window --space next ; yabai -m space --focus next
ctrl - y : yabai -m space --focus prev
ctrl - o : yabai -m space --focus next

# Focus window
ctrl - h     : yabai -m window --focus west  || yabai -m display --focus west
ctrl - j     : yabai -m window --focus south || yabai -m display --focus south
ctrl - k     : yabai -m window --focus north || yabai -m display --focus north
ctrl - l     : yabai -m window --focus east  || yabai -m display --focus east

ctrl - left  : yabai -m window --focus west  || yabai -m display --focus west
ctrl - down  : yabai -m window --focus south || yabai -m display --focus south
ctrl - up    : yabai -m window --focus north || yabai -m display --focus north
ctrl - right : yabai -m window --focus east  || yabai -m display --focus east

# Swap windows
ctrl - n     : yabai -m window --swap west   || ( yabai -m window --display west  && yabai -m window --focus recent )
ctrl - m     : yabai -m window --swap south  || ( yabai -m window --display south && yabai -m window --focus recent )
ctrl - 0x2B  : yabai -m window --swap north  || ( yabai -m window --display north && yabai -m window --focus recent )
ctrl - 0x2F  : yabai -m window --swap east   || ( yabai -m window --display east  && yabai -m window --focus recent )
ctrl - 0x2C  : yabai -m space --mirror y-axis
ctrl - 0x29  : yabai -m space --mirror x-axis
ctrl - p     : yabai -m space --rotate 270
